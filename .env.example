# JobMatix PostgreSQL Connection Settings
# Copy this file to .env and update with your settings

# PostgreSQL Database Settings
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=jobmatix_user
POSTGRES_PASSWORD=JobMatix2026!Dev
POSTGRES_DB_MAIN=jobmatix_main
POSTGRES_DB_JOBS=jobmatix_jobs
POSTGRES_DB_POS=jobmatix_pos
POSTGRES_DB_BACKUP=jobmatix_backup

# pgAdmin Settings
PGADMIN_EMAIL=admin@jobmatix.local
PGADMIN_PASSWORD=admin
PGADMIN_PORT=5050

# Connection Strings (for .NET applications)
# Format: Host={host};Port={port};Database={database};Username={username};Password={password}
CONN_STRING_JOBS=Host=localhost;Port=5432;Database=jobmatix_jobs;Username=jobmatix_user;Password=JobMatix2026!Dev;Pooling=true;Maximum Pool Size=20;
CONN_STRING_POS=Host=localhost;Port=5432;Database=jobmatix_pos;Username=jobmatix_user;Password=JobMatix2026!Dev;Pooling=true;Maximum Pool Size=20;
CONN_STRING_BACKUP=Host=localhost;Port=5432;Database=jobmatix_backup;Username=jobmatix_user;Password=JobMatix2026!Dev;Pooling=true;Maximum Pool Size=20;
