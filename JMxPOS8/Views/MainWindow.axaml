<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:JMxPOS8.ViewModels"
        xmlns:views="using:JMxPOS8.Views"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:sys="clr-namespace:System;assembly=System.Runtime"
        mc:Ignorable="d" d:DesignWidth="1200" d:DesignHeight="800"
        x:Class="JMxPOS8.Views.MainWindow"
        Title="JobMatix POS v8.0"
        Width="1200" Height="800">

    <Design.DataContext>
        <vm:MainWindowViewModel/>
    </Design.DataContext>

    <Window.Styles>
        <!-- Sale tab strip chips: light/neutral by default, the active one stands out with
             a white background and a green accent underline instead of a heavy dark bar. -->
        <Style Selector="Border.saleTab">
            <Setter Property="Background" Value="#F0F0F0"/>
            <Setter Property="BorderBrush" Value="#D0D0D0"/>
        </Style>
        <Style Selector="Border.saleTab.active">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#2E7D32"/>
        </Style>
        <!-- Screens reached via a menu item rather than the top tab strip (Staff,
             Transaction Lookup, Stocktake, Intake, Returns, Reports, Reference Data) -
             still real TabItems (so SelectedTabIndex-based navigation is unchanged),
             just not shown as a header button. -->
        <Style Selector="TabItem.navhidden">
            <Setter Property="IsVisible" Value="False"/>
        </Style>
        <!-- Ticket notes: private (internal-only) vs public (customer-facing), color-coded
             so the difference is visible at a glance without reading the badge text. -->
        <Style Selector="Border.privateNote">
            <Setter Property="Background" Value="#FFF3E0"/>
            <Setter Property="BorderBrush" Value="#FFB74D"/>
        </Style>
        <Style Selector="Border.publicNote">
            <Setter Property="Background" Value="#E8F5E9"/>
            <Setter Property="BorderBrush" Value="#81C784"/>
        </Style>
    </Window.Styles>

    <DockPanel>
        <!-- Menu Bar -->
        <Menu DockPanel.Dock="Top">
            <MenuItem Header="_File">
                <MenuItem Header="E_xit" Command="{Binding ExitCommand}" InputGesture="Alt+F4"/>
            </MenuItem>
            <MenuItem Header="_Sales">
                <MenuItem Header="_New Sale" Command="{Binding NewSaleTabCommand}" InputGesture="F9"/>
                <MenuItem Header="_Hold Sale" Command="{Binding HoldSaleCommand}" InputGesture="F6"/>
                <Separator/>
                <MenuItem Header="_Show Last Invoice" Command="{Binding ShowLastInvoiceCommand}" InputGesture="F8"/>
                <MenuItem Header="_Transaction Lookup" Command="{Binding TransactionLookupCommand}"/>
            </MenuItem>
            <MenuItem Header="S_tock">
                <MenuItem Header="_Stock List" Command="{Binding StockListCommand}" InputGesture="Ctrl+O"/>
                <MenuItem Header="_Find Stock" Command="{Binding FindStockCommand}" InputGesture="F2"/>
                <Separator/>
                <MenuItem Header="_New Stock Item" Command="{Binding NewStockItemCommand}" InputGesture="F5"/>
                <Separator/>
                <MenuItem Header="Stock_take" Command="{Binding StocktakeCommand}"/>
                <MenuItem Header="_Intake (Goods Received)" Command="{Binding GoodsReceivedCommand}"/>
                <MenuItem Header="_Returns" Command="{Binding ReturnAuthorizationsCommand}"/>
            </MenuItem>
            <MenuItem Header="_Customers">
                <MenuItem Header="_Customer List" Command="{Binding CustomerListCommand}" InputGesture="Ctrl+U"/>
                <MenuItem Header="_Find Customer" Command="{Binding FindCustomerCommand}" InputGesture="F3"/>
                <Separator/>
                <MenuItem Header="_New Customer" Command="{Binding NewCustomerItemCommand}" InputGesture="F5"/>
            </MenuItem>
            <MenuItem Header="_Staff">
                <MenuItem Header="Staff _List" Command="{Binding StaffListCommand}"/>
                <MenuItem Header="_New Staff Member" Command="{Binding NewStaffItemCommand}"/>
                <Separator/>
                <MenuItem Header="_Lock Staff Admin" Command="{Binding LockStaffAdminCommand}" IsEnabled="{Binding IsStaffAdminUnlocked}"/>
            </MenuItem>
            <MenuItem Header="_Tickets">
                <MenuItem Header="Ticket _List" Command="{Binding JobsCommand}"/>
                <Separator/>
                <MenuItem Header="_Reference Data">
                    <MenuItem Header="_Goods Accepted Types" Command="{Binding OpenGoodsTypesCommand}"/>
                    <MenuItem Header="_Brands" Command="{Binding OpenBrandsCommand}"/>
                    <MenuItem Header="_Problem Symptoms" Command="{Binding OpenSymptomsCommand}"/>
                    <MenuItem Header="_Task Types" Command="{Binding OpenTaskTypesCommand}"/>
                </MenuItem>
            </MenuItem>
            <MenuItem Header="_Reports">
                <MenuItem Header="_Sales Report" Command="{Binding SalesReportCommand}"/>
                <MenuItem Header="S_tock Report" Command="{Binding StockReportCommand}"/>
                <MenuItem Header="C_ustomer Report" Command="{Binding CustomerReportCommand}"/>
                <Separator/>
                <MenuItem Header="_Cash Up" Command="{Binding CashupCommand}"/>
            </MenuItem>
            <MenuItem Header="_Help">
                <MenuItem Header="_About" Command="{Binding AboutCommand}"/>
            </MenuItem>
        </Menu>

        <!-- Status Bar -->
        <Panel DockPanel.Dock="Bottom" Height="30" Background="#F0F0F0">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="5,0">
                <TextBlock Text="{Binding StatusText}" Margin="0,0,20,0"/>
                <Rectangle Width="1" Fill="Gray" Margin="0,2"/>
                <TextBlock Text="{Binding StaffInfo}" Margin="20,0"/>
                <Rectangle Width="1" Fill="Gray" Margin="0,2"/>
                <TextBlock Text="{Binding TillInfo}" Margin="20,0"/>
                <Rectangle Width="1" Fill="Gray" Margin="0,2"/>
                <TextBlock Text="{Binding Source={x:Static sys:DateTime.Now}, StringFormat='HH:mm:ss'}" Margin="20,0"/>
            </StackPanel>
        </Panel>

        <!-- Main Content Area with Tabs -->
        <TabControl SelectedIndex="{Binding SelectedTabIndex}">
            <!-- Sales Tab -->
            <TabItem Header="Sale">
                <Grid Margin="0" RowDefinitions="Auto,*">
                    <!-- Tab strip for concurrent sale documents. The row of existing tab
                         chips only appears once a second sale is actually open, so the
                         common single-sale case looks almost exactly as before - but the
                         "+" itself stays visible at all times, so there's always a way to
                         open another tab (it used to be nested inside the same hidden
                         container as the chips, so closing back down to one tab left no
                         way to open a second one again except a smart-guard menu command
                         that silently no-ops on an empty sale). -->
                    <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Background="Transparent">
                        <ItemsControl Grid.Column="0" ItemsSource="{Binding OpenSales}" IsVisible="{Binding HasMultipleSaleTabs}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Classes="saleTab" Classes.active="{Binding IsActive}"
                                            Margin="0,4,4,0" Padding="10,6" CornerRadius="4,4,0,0" BorderThickness="1,1,1,0">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <Button Content="{Binding TabTitle}" Background="Transparent" BorderThickness="0" Padding="0"
                                                    Command="{Binding $parent[Window].DataContext.SelectSaleTabCommand}" CommandParameter="{Binding}"/>
                                            <Button Content="✕" Width="20" Height="20" Padding="0" Background="Transparent" BorderThickness="0"
                                                    Command="{Binding $parent[Window].DataContext.CloseSaleTabCommand}" CommandParameter="{Binding}"/>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <Button Grid.Column="1" Content="+ New Sale" Height="28" Padding="10,0" Margin="0,4,4,0"
                                Command="{Binding NewSaleTabCommand}" ToolTip.Tip="Open a new sale tab (F9)"
                                Background="#F0F0F0" BorderBrush="#D0D0D0" CornerRadius="4"/>
                    </Grid>

                    <ContentControl Grid.Row="1" Content="{Binding ActiveSaleDocument}">
                        <ContentControl.ContentTemplate>
                            <DataTemplate DataType="vm:SaleViewModel">
                                <views:SaleTabView/>
                            </DataTemplate>
                        </ContentControl.ContentTemplate>
                    </ContentControl>
                </Grid>
            </TabItem>

            <!-- Stock Tab -->
            <TabItem Header="Stock">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*"/>
                        <ColumnDefinition Width="3*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Search and Actions -->
                    <StackPanel Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2" Orientation="Horizontal" Margin="0,0,0,10">
                        <TextBlock Text="Search:" VerticalAlignment="Center" Margin="0,0,5,0"/>
                        <TextBox Name="txtStockSearch" Width="300" Watermark="Search by code, barcode, or description..."
                                 Text="{Binding StockViewModel.SearchText}"/>
                        <Button Content="🔍" Width="30" Margin="5,0" Command="{Binding StockViewModel.SearchStockCommand}"/>
                        <Button Content="New" Width="80" Margin="10,0,5,0" Command="{Binding StockViewModel.NewStockCommand}"/>
                        <Button Content="Edit" Width="80" Margin="5,0" Command="{Binding StockViewModel.EditStockCommand}"/>
                        <Button Content="Delete" Width="80" Margin="5,0" Command="{Binding StockViewModel.DeleteStockCommand}"/>
                        <Button Content="Adjust Qty" Width="90" Margin="5,0" Command="{Binding StockViewModel.AdjustQuantityCommand}"/>
                        <Button Content="Refresh" Width="80" Margin="5,0" Command="{Binding StockViewModel.RefreshCommand}"/>
                    </StackPanel>

                    <!-- Stock List -->
                    <Border Grid.Row="1" Grid.Column="0" BorderBrush="Gray" BorderThickness="1" Margin="0,0,10,0">
                        <ListBox Name="dgStock" 
                                 ItemsSource="{Binding StockViewModel.StockItems}"
                                 SelectedItem="{Binding StockViewModel.SelectedStock}"
                                 SelectionMode="Single">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="LightGray" BorderThickness="0,0,0,1" Padding="5">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="100"/>
                                                <ColumnDefinition Width="100"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="60"/>
                                                <ColumnDefinition Width="90"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{Binding Barcode}" Margin="5,0"/>
                                            <TextBlock Grid.Column="1" Text="{Binding StockCode}" Margin="5,0"/>
                                            <TextBlock Grid.Column="2" Text="{Binding Description}" Margin="5,0"/>
                                            <TextBlock Grid.Column="3" Text="{Binding QuantityInStock}" Margin="5,0" HorizontalAlignment="Right"/>
                                            <TextBlock Grid.Column="4" Text="{Binding SellPrice, StringFormat=C}" Margin="5,0" HorizontalAlignment="Right"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Border>

                    <!-- Stock Detail Form -->
                    <Border Grid.Row="1" Grid.Column="1" BorderBrush="Gray" BorderThickness="1" Padding="10">
                        <ScrollViewer>
                            <StackPanel Spacing="5">
                                <TextBlock Text="Stock Item Details" FontSize="16" FontWeight="Bold" Margin="0,0,0,10"/>

                                <!-- Basic Info -->
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="120"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Barcode:*" VerticalAlignment="Center"/>
                                    <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding StockViewModel.Barcode}" 
                                             IsReadOnly="{Binding !StockViewModel.IsEditing}" 
                                             IsHitTestVisible="{Binding StockViewModel.IsEditing}" Margin="0,2"/>

                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Stock Code:*" VerticalAlignment="Center"/>
                                    <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding StockViewModel.StockCode}" 
                                             IsReadOnly="{Binding !StockViewModel.IsEditing}" 
                                             IsHitTestVisible="{Binding StockViewModel.IsEditing}" Margin="0,2"/>

                                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Description:*" VerticalAlignment="Center"/>
                                    <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding StockViewModel.Description}" 
                                             IsReadOnly="{Binding !StockViewModel.IsEditing}" 
                                             IsHitTestVisible="{Binding StockViewModel.IsEditing}" Margin="0,2"/>

                                    <TextBlock Grid.Row="3" Grid.Column="0" Text="Category:" VerticalAlignment="Center"/>
                                    <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding StockViewModel.Category}" 
                                             IsReadOnly="{Binding !StockViewModel.IsEditing}" 
                                             IsHitTestVisible="{Binding StockViewModel.IsEditing}" Margin="0,2"/>

                                    <TextBlock Grid.Row="4" Grid.Column="0" Text="Inactive:" VerticalAlignment="Center"/>
                                    <CheckBox Grid.Row="4" Grid.Column="1" IsChecked="{Binding StockViewModel.Inactive}" 
                                              IsEnabled="{Binding StockViewModel.IsEditing}" Margin="0,2"/>
                                </Grid>

                                <!-- Pricing -->
                                <Separator Margin="0,10"/>
                                <TextBlock Text="Pricing" FontWeight="Bold"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="120"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Cost Price:" VerticalAlignment="Center"/>
                                    <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding StockViewModel.CostPrice}" 
                                             IsReadOnly="{Binding !StockViewModel.IsEditing}" 
                                             IsHitTestVisible="{Binding StockViewModel.IsEditing}" Margin="0,2"/>

                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Sell Price:" VerticalAlignment="Center"/>
                                    <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding StockViewModel.SellPrice}" 
                                             IsReadOnly="{Binding !StockViewModel.IsEditing}" 
                                             IsHitTestVisible="{Binding StockViewModel.IsEditing}" Margin="0,2"/>
                                </Grid>

                                <!-- Inventory -->
                                <Separator Margin="0,10"/>
                                <TextBlock Text="Inventory" FontWeight="Bold"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="120"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Quantity:" VerticalAlignment="Center"/>
                                    <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding StockViewModel.QuantityInStock}" 
                                             IsReadOnly="{Binding !StockViewModel.IsEditing}" 
                                             IsHitTestVisible="{Binding StockViewModel.IsEditing}" Margin="0,2"/>

                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Reorder Level:" VerticalAlignment="Center"/>
                                    <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding StockViewModel.ReorderLevel}" 
                                             IsReadOnly="{Binding !StockViewModel.IsEditing}" 
                                             IsHitTestVisible="{Binding StockViewModel.IsEditing}" Margin="0,2"/>

                                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Reorder Qty:" VerticalAlignment="Center"/>
                                    <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding StockViewModel.ReorderQuantity}" 
                                             IsReadOnly="{Binding !StockViewModel.IsEditing}" 
                                             IsHitTestVisible="{Binding StockViewModel.IsEditing}" Margin="0,2"/>

                                    <TextBlock Grid.Row="3" Grid.Column="0" Text="Location:" VerticalAlignment="Center"/>
                                    <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding StockViewModel.Location}" 
                                             IsReadOnly="{Binding !StockViewModel.IsEditing}" 
                                             IsHitTestVisible="{Binding StockViewModel.IsEditing}" Margin="0,2"/>

                                    <TextBlock Grid.Row="4" Grid.Column="0" Text="Requires Serial:" VerticalAlignment="Center"/>
                                    <CheckBox Grid.Row="4" Grid.Column="1" IsChecked="{Binding StockViewModel.RequiresSerial}" 
                                              IsEnabled="{Binding StockViewModel.IsEditing}" Margin="0,2"/>
                                </Grid>

                                <!-- Supplier -->
                                <Separator Margin="0,10"/>
                                <TextBlock Text="Supplier" FontWeight="Bold"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="120"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Supplier:" VerticalAlignment="Center"/>
                                    <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding StockViewModel.Supplier}" 
                                             IsReadOnly="{Binding !StockViewModel.IsEditing}" 
                                             IsHitTestVisible="{Binding StockViewModel.IsEditing}" Margin="0,2"/>
                                </Grid>

                                <!-- Notes -->
                                <Separator Margin="0,10"/>
                                <TextBlock Text="Notes" FontWeight="Bold"/>
                                <TextBox Text="{Binding StockViewModel.Notes}" AcceptsReturn="True" Height="80" 
                                         TextWrapping="Wrap" IsReadOnly="{Binding !StockViewModel.IsEditing}" 
                                         IsHitTestVisible="{Binding StockViewModel.IsEditing}" Margin="0,2"/>

                                <!-- Action Buttons -->
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0"
                                            IsVisible="{Binding StockViewModel.IsEditing}">
                                    <Button Content="Save" Width="100" Margin="0,0,10,0" 
                                            Command="{Binding StockViewModel.SaveStockCommand}"
                                            Background="Green" Foreground="White"/>
                                    <Button Content="Cancel" Width="100" 
                                            Command="{Binding StockViewModel.CancelEditCommand}"/>
                                </StackPanel>
                            </StackPanel>
                        </ScrollViewer>
                    </Border>

                    <!-- Status Message -->
                    <TextBlock Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" 
                               Text="{Binding StockViewModel.StatusMessage}" 
                               Margin="0,10,0,0" FontStyle="Italic"/>
                </Grid>
            </TabItem>

            <!-- Customers Tab -->
            <TabItem Header="Customers">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*"/>
                        <ColumnDefinition Width="3*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Search and Actions -->
                    <StackPanel Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2" Orientation="Horizontal" Margin="0,0,0,10">
                        <TextBlock Text="Search:" VerticalAlignment="Center" Margin="0,0,5,0"/>
                        <TextBox Name="txtCustomerSearch" Width="300" Watermark="Search by name, company, or barcode..."
                                 Text="{Binding CustomerViewModel.SearchText}"/>
                        <Button Content="🔍" Width="30" Margin="5,0" Command="{Binding CustomerViewModel.SearchCustomersCommand}"/>
                        <Button Content="New" Width="80" Margin="10,0,5,0" Command="{Binding CustomerViewModel.NewCustomerCommand}"/>
                        <Button Content="Edit" Width="80" Margin="5,0" Command="{Binding CustomerViewModel.EditCustomerCommand}"/>
                        <Button Content="Delete" Width="80" Margin="5,0" Command="{Binding CustomerViewModel.DeleteCustomerCommand}"/>
                        <Button Content="Refresh" Width="80" Margin="5,0" Command="{Binding CustomerViewModel.RefreshCommand}"/>
                    </StackPanel>

                    <!-- Customer List -->
                    <Border Grid.Row="1" Grid.Column="0" BorderBrush="Gray" BorderThickness="1" Margin="0,0,10,0">
                        <ListBox Name="dgCustomers" 
                                 ItemsSource="{Binding CustomerViewModel.Customers}"
                                 SelectedItem="{Binding CustomerViewModel.SelectedCustomer}"
                                 SelectionMode="Single">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="LightGray" BorderThickness="0,0,0,1" Padding="5">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="100"/>
                                                <ColumnDefinition Width="150"/>
                                                <ColumnDefinition Width="150"/>
                                                <ColumnDefinition Width="100"/>
                                                <ColumnDefinition Width="100"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{Binding Barcode}" Margin="5,0"/>
                                            <TextBlock Grid.Column="1" Text="{Binding CustomerName}" Margin="5,0"/>
                                            <TextBlock Grid.Column="2" Text="{Binding CompanyName}" Margin="5,0"/>
                                            <TextBlock Grid.Column="3" Text="{Binding BusinessPhone}" Margin="5,0"/>
                                            <TextBlock Grid.Column="4" Text="{Binding AccountBalance, StringFormat=C}" Margin="5,0" HorizontalAlignment="Right"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Border>

                    <!-- Customer Detail Form -->
                    <Border Grid.Row="1" Grid.Column="1" BorderBrush="Gray" BorderThickness="1">
                      <TabControl>
                        <TabItem Header="Details">
                        <ScrollViewer>
                            <StackPanel Spacing="5" Margin="10">
                                <TextBlock Text="Customer Details" FontSize="16" FontWeight="Bold" Margin="0,0,0,10"/>

                                <!-- Basic Info -->
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="120"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Barcode:*" VerticalAlignment="Center"/>
                                    <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding CustomerViewModel.Barcode}" 
                                             IsReadOnly="{Binding !CustomerViewModel.IsEditing}" 
                                             IsHitTestVisible="{Binding CustomerViewModel.IsEditing}" Margin="0,2"/>

                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Customer Name:*" VerticalAlignment="Center"/>
                                    <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding CustomerViewModel.CustomerName}" 
                                             IsReadOnly="{Binding !CustomerViewModel.IsEditing}" 
                                             IsHitTestVisible="{Binding CustomerViewModel.IsEditing}" Margin="0,2"/>

                                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Company Name:" VerticalAlignment="Center"/>
                                    <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding CustomerViewModel.CompanyName}" 
                                             IsReadOnly="{Binding !CustomerViewModel.IsEditing}" 
                                             IsHitTestVisible="{Binding CustomerViewModel.IsEditing}" Margin="0,2"/>

                                    <TextBlock Grid.Row="3" Grid.Column="0" Text="Grade:" VerticalAlignment="Center"/>
                                    <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding CustomerViewModel.Grade}" 
                                             IsReadOnly="{Binding !CustomerViewModel.IsEditing}" 
                                             IsHitTestVisible="{Binding CustomerViewModel.IsEditing}" Margin="0,2"/>

                                    <TextBlock Grid.Row="4" Grid.Column="0" Text="Inactive:" VerticalAlignment="Center"/>
                                    <CheckBox Grid.Row="4" Grid.Column="1" IsChecked="{Binding CustomerViewModel.Inactive}" 
                                              IsEnabled="{Binding CustomerViewModel.IsEditing}" Margin="0,2"/>
                                </Grid>

                                <!-- Contact Info -->
                                <Separator Margin="0,10"/>
                                <TextBlock Text="Contact Information" FontWeight="Bold"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="120"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Contact Name:" VerticalAlignment="Center"/>
                                    <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding CustomerViewModel.ContactName}" 
                                             IsReadOnly="{Binding !CustomerViewModel.IsEditing}" 
                                             IsHitTestVisible="{Binding CustomerViewModel.IsEditing}" Margin="0,2"/>

                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Position:" VerticalAlignment="Center"/>
                                    <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding CustomerViewModel.ContactPosition}" 
                                             IsReadOnly="{Binding !CustomerViewModel.IsEditing}" 
                                             IsHitTestVisible="{Binding CustomerViewModel.IsEditing}" Margin="0,2"/>
                                </Grid>

                                <!-- Address -->
                                <Separator Margin="0,10"/>
                                <TextBlock Text="Address" FontWeight="Bold"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="120"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Address:" VerticalAlignment="Center"/>
                                    <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding CustomerViewModel.Address}" 
                                             AcceptsReturn="True" Height="60" 
                                             IsReadOnly="{Binding !CustomerViewModel.IsEditing}" 
                                             IsHitTestVisible="{Binding CustomerViewModel.IsEditing}" Margin="0,2"/>

                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Suburb:" VerticalAlignment="Center"/>
                                    <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding CustomerViewModel.Suburb}" 
                                             IsReadOnly="{Binding !CustomerViewModel.IsEditing}" 
                                             IsHitTestVisible="{Binding CustomerViewModel.IsEditing}" Margin="0,2"/>

                                    <TextBlock Grid.Row="2" Grid.Column="0" Text="State:" VerticalAlignment="Center"/>
                                    <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding CustomerViewModel.State}" 
                                             IsReadOnly="{Binding !CustomerViewModel.IsEditing}" 
                                             IsHitTestVisible="{Binding CustomerViewModel.IsEditing}" Margin="0,2"/>

                                    <TextBlock Grid.Row="3" Grid.Column="0" Text="Postcode:" VerticalAlignment="Center"/>
                                    <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding CustomerViewModel.Postcode}" 
                                             IsReadOnly="{Binding !CustomerViewModel.IsEditing}" 
                                             IsHitTestVisible="{Binding CustomerViewModel.IsEditing}" Margin="0,2"/>

                                    <TextBlock Grid.Row="4" Grid.Column="0" Text="Country:" VerticalAlignment="Center"/>
                                    <TextBox Grid.Row="4" Grid.Column="1" Text="{Binding CustomerViewModel.Country}" 
                                             IsReadOnly="{Binding !CustomerViewModel.IsEditing}" 
                                             IsHitTestVisible="{Binding CustomerViewModel.IsEditing}" Margin="0,2"/>
                                </Grid>

                                <!-- Phone Numbers -->
                                <Separator Margin="0,10"/>
                                <TextBlock Text="Phone Numbers" FontWeight="Bold"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="120"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Business:" VerticalAlignment="Center"/>
                                    <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding CustomerViewModel.BusinessPhone}" 
                                             IsReadOnly="{Binding !CustomerViewModel.IsEditing}" 
                                             IsHitTestVisible="{Binding CustomerViewModel.IsEditing}" Margin="0,2"/>

                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Home:" VerticalAlignment="Center"/>
                                    <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding CustomerViewModel.HomePhone}" 
                                             IsReadOnly="{Binding !CustomerViewModel.IsEditing}" 
                                             IsHitTestVisible="{Binding CustomerViewModel.IsEditing}" Margin="0,2"/>

                                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Mobile:" VerticalAlignment="Center"/>
                                    <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding CustomerViewModel.Mobile}" 
                                             IsReadOnly="{Binding !CustomerViewModel.IsEditing}" 
                                             IsHitTestVisible="{Binding CustomerViewModel.IsEditing}" Margin="0,2"/>

                                    <TextBlock Grid.Row="3" Grid.Column="0" Text="Fax:" VerticalAlignment="Center"/>
                                    <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding CustomerViewModel.Fax}" 
                                             IsReadOnly="{Binding !CustomerViewModel.IsEditing}" 
                                             IsHitTestVisible="{Binding CustomerViewModel.IsEditing}" Margin="0,2"/>
                                </Grid>

                                <!-- Email & Web -->
                                <Separator Margin="0,10"/>
                                <TextBlock Text="Email &amp; Website" FontWeight="Bold"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="120"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Email:" VerticalAlignment="Center"/>
                                    <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding CustomerViewModel.EmailAddress}" 
                                             IsReadOnly="{Binding !CustomerViewModel.IsEditing}" 
                                             IsHitTestVisible="{Binding CustomerViewModel.IsEditing}" Margin="0,2"/>

                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Website:" VerticalAlignment="Center"/>
                                    <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding CustomerViewModel.Website}" 
                                             IsReadOnly="{Binding !CustomerViewModel.IsEditing}" 
                                             IsHitTestVisible="{Binding CustomerViewModel.IsEditing}" Margin="0,2"/>
                                </Grid>

                                <!-- Tax & Account -->
                                <Separator Margin="0,10"/>
                                <TextBlock Text="Tax &amp; Account Information" FontWeight="Bold"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="120"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="ABN:" VerticalAlignment="Center"/>
                                    <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding CustomerViewModel.Abn}" 
                                             IsReadOnly="{Binding !CustomerViewModel.IsEditing}" 
                                             IsHitTestVisible="{Binding CustomerViewModel.IsEditing}" Margin="0,2"/>

                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Tax Code:" VerticalAlignment="Center"/>
                                    <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding CustomerViewModel.TaxCode}" 
                                             IsReadOnly="{Binding !CustomerViewModel.IsEditing}" 
                                             IsHitTestVisible="{Binding CustomerViewModel.IsEditing}" Margin="0,2"/>

                                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Is Account:" VerticalAlignment="Center"/>
                                    <CheckBox Grid.Row="2" Grid.Column="1" IsChecked="{Binding CustomerViewModel.IsAccount}" 
                                              IsEnabled="{Binding CustomerViewModel.IsEditing}" Margin="0,2"/>

                                    <TextBlock Grid.Row="3" Grid.Column="0" Text="Account Balance:" VerticalAlignment="Center"/>
                                    <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding CustomerViewModel.AccountBalance}" 
                                             IsReadOnly="{Binding !CustomerViewModel.IsEditing}" 
                                             IsHitTestVisible="{Binding CustomerViewModel.IsEditing}" Margin="0,2"/>

                                    <TextBlock Grid.Row="4" Grid.Column="0" Text="Credit Limit:" VerticalAlignment="Center"/>
                                    <TextBox Grid.Row="4" Grid.Column="1" Text="{Binding CustomerViewModel.CreditLimit}" 
                                             IsReadOnly="{Binding !CustomerViewModel.IsEditing}" 
                                             IsHitTestVisible="{Binding CustomerViewModel.IsEditing}" Margin="0,2"/>
                                </Grid>

                                <!-- Notes -->
                                <Separator Margin="0,10"/>
                                <TextBlock Text="Notes" FontWeight="Bold"/>
                                <TextBox Text="{Binding CustomerViewModel.Notes}" AcceptsReturn="True" Height="80" 
                                         TextWrapping="Wrap" 
                                         IsReadOnly="{Binding !CustomerViewModel.IsEditing}" 
                                         IsHitTestVisible="{Binding CustomerViewModel.IsEditing}" Margin="0,2"/>

                                <!-- Action Buttons -->
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0"
                                            IsVisible="{Binding CustomerViewModel.IsEditing}">
                                    <Button Content="Save" Width="100" Margin="0,0,10,0" 
                                            Command="{Binding CustomerViewModel.SaveCustomerCommand}"
                                            Background="Green" Foreground="White"/>
                                    <Button Content="Cancel" Width="100" 
                                            Command="{Binding CustomerViewModel.CancelEditCommand}"/>
                                </StackPanel>
                            </StackPanel>
                        </ScrollViewer>
                        </TabItem>

                        <TabItem Header="Invoices">
                            <ListBox ItemsSource="{Binding CustomerViewModel.Invoices}">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid ColumnDefinitions="140,*,90,100" Margin="5,3">
                                            <TextBlock Grid.Column="0" Text="{Binding InvoiceDate, StringFormat='{}{0:dd-MMM-yyyy}'}"/>
                                            <TextBlock Grid.Column="1" Text="{Binding InvoiceNumber}"/>
                                            <TextBlock Grid.Column="2" Text="{Binding TransactionType}"/>
                                            <TextBlock Grid.Column="3" Text="{Binding TotalInc, StringFormat=C}" HorizontalAlignment="Right"/>
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </TabItem>

                        <TabItem Header="Item Sales">
                            <ListBox ItemsSource="{Binding CustomerViewModel.ItemSales}">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid ColumnDefinitions="140,*,70,90,100" Margin="5,3">
                                            <TextBlock Grid.Column="0" Text="{Binding InvoiceDate, StringFormat='{}{0:dd-MMM-yyyy}'}"/>
                                            <TextBlock Grid.Column="1" Text="{Binding Description}"/>
                                            <TextBlock Grid.Column="2" Text="{Binding Quantity, StringFormat=N2}" HorizontalAlignment="Right"/>
                                            <TextBlock Grid.Column="3" Text="{Binding UnitPrice, StringFormat=C}" HorizontalAlignment="Right"/>
                                            <TextBlock Grid.Column="4" Text="{Binding LineTotal, StringFormat=C}" HorizontalAlignment="Right"/>
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </TabItem>

                        <TabItem Header="Payments">
                            <ListBox ItemsSource="{Binding CustomerViewModel.Payments}">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid ColumnDefinitions="140,*,90,100" Margin="5,3">
                                            <TextBlock Grid.Column="0" Text="{Binding PaymentDate, StringFormat='{}{0:dd-MMM-yyyy}'}"/>
                                            <TextBlock Grid.Column="1" Text="{Binding PaymentMethod}"/>
                                            <TextBlock Grid.Column="2" Text="{Binding TransactionType}"/>
                                            <TextBlock Grid.Column="3" Text="{Binding Amount, StringFormat=C}" HorizontalAlignment="Right"/>
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </TabItem>

                        <TabItem Header="Quotes">
                            <ListBox ItemsSource="{Binding CustomerViewModel.Quotes}">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid ColumnDefinitions="140,*,90,100" Margin="5,3">
                                            <TextBlock Grid.Column="0" Text="{Binding InvoiceDate, StringFormat='{}{0:dd-MMM-yyyy}'}"/>
                                            <TextBlock Grid.Column="1" Text="{Binding InvoiceNumber}"/>
                                            <TextBlock Grid.Column="2" Text="{Binding TransactionType}"/>
                                            <TextBlock Grid.Column="3" Text="{Binding TotalInc, StringFormat=C}" HorizontalAlignment="Right"/>
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </TabItem>

                        <TabItem Header="Tickets">
                            <ListBox ItemsSource="{Binding CustomerViewModel.Jobs}">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid ColumnDefinitions="60,110,120,120,*,50" Margin="5,3">
                                            <Button Grid.Column="0" Content="{Binding JobId, StringFormat='#{0}'}" FontWeight="Bold"
                                                    Padding="0" Background="Transparent" BorderThickness="0" Foreground="#1565C0"
                                                    Cursor="Hand" HorizontalContentAlignment="Left"
                                                    Command="{Binding $parent[Window].DataContext.CustomerViewModel.OpenJobCommand}"
                                                    CommandParameter="{Binding}"/>
                                            <TextBlock Grid.Column="1" Text="{Binding DateUpdated, StringFormat='{}{0:dd-MMM-yyyy}'}"/>
                                            <TextBlock Grid.Column="2" Text="{Binding JobStatus}"/>
                                            <TextBlock Grid.Column="3" Text="{Binding TechStaffName}"/>
                                            <TextBlock Grid.Column="4" Text="{Binding ProblemSymptoms}"/>
                                            <TextBlock Grid.Column="5" Text="{Binding Priority}" HorizontalAlignment="Right"/>
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </TabItem>
                      </TabControl>
                    </Border>

                    <!-- Status Message -->
                    <TextBlock Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2"
                               Text="{Binding CustomerViewModel.StatusMessage}"
                               Margin="0,10,0,0" FontStyle="Italic"/>
                </Grid>
            </TabItem>

            <!-- Staff Tab -->
            <TabItem Header="Staff" Classes="navhidden">
              <Panel>
                <Grid Margin="10" IsVisible="{Binding IsStaffAdminUnlocked}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*"/>
                        <ColumnDefinition Width="3*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Search and Actions -->
                    <StackPanel Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2" Orientation="Horizontal" Margin="0,0,0,10">
                        <TextBlock Text="Search:" VerticalAlignment="Center" Margin="0,0,5,0"/>
                        <TextBox Name="txtStaffSearch" Width="300" Watermark="Search by name or staff number..."
                                 Text="{Binding StaffViewModel.SearchText}"/>
                        <Button Content="🔍" Width="30" Margin="5,0" Command="{Binding StaffViewModel.SearchStaffCommand}"/>
                        <Button Content="New" Width="80" Margin="10,0,5,0" Command="{Binding StaffViewModel.NewStaffCommand}"/>
                        <Button Content="Edit" Width="80" Margin="5,0" Command="{Binding StaffViewModel.EditStaffCommand}"/>
                        <Button Content="Delete" Width="80" Margin="5,0" Command="{Binding StaffViewModel.DeleteStaffCommand}"/>
                        <Button Content="Refresh" Width="80" Margin="5,0" Command="{Binding StaffViewModel.RefreshCommand}"/>
                    </StackPanel>

                    <!-- Staff List -->
                    <Border Grid.Row="1" Grid.Column="0" BorderBrush="Gray" BorderThickness="1" Margin="0,0,10,0">
                        <ListBox Name="dgStaff"
                                 ItemsSource="{Binding StaffViewModel.StaffMembers}"
                                 SelectedItem="{Binding StaffViewModel.SelectedStaff}"
                                 SelectionMode="Single">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="LightGray" BorderThickness="0,0,0,1" Padding="5">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="80"/>
                                                <ColumnDefinition Width="150"/>
                                                <ColumnDefinition Width="120"/>
                                                <ColumnDefinition Width="80"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{Binding Barcode}" Margin="5,0"/>
                                            <TextBlock Grid.Column="1" Text="{Binding DocketName}" Margin="5,0"/>
                                            <TextBlock Grid.Column="2" Text="{Binding Position}" Margin="5,0"/>
                                            <TextBlock Grid.Column="3" Text="Admin" FontWeight="Bold" Foreground="DarkGreen"
                                                       IsVisible="{Binding IsAdministrator}" Margin="5,0"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Border>

                    <!-- Staff Detail Form -->
                    <Border Grid.Row="1" Grid.Column="1" BorderBrush="Gray" BorderThickness="1" Padding="10">
                        <ScrollViewer>
                            <StackPanel Spacing="5">
                                <TextBlock Text="Staff Details" FontSize="16" FontWeight="Bold" Margin="0,0,0,10"/>

                                <!-- Basic Info -->
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="120"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Staff Number:*" VerticalAlignment="Center"/>
                                    <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding StaffViewModel.Barcode}"
                                             IsReadOnly="{Binding !StaffViewModel.IsEditing}"
                                             IsHitTestVisible="{Binding StaffViewModel.IsEditing}" Margin="0,2"/>

                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="First Name:*" VerticalAlignment="Center"/>
                                    <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding StaffViewModel.FirstName}"
                                             IsReadOnly="{Binding !StaffViewModel.IsEditing}"
                                             IsHitTestVisible="{Binding StaffViewModel.IsEditing}" Margin="0,2"/>

                                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Last Name:*" VerticalAlignment="Center"/>
                                    <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding StaffViewModel.LastName}"
                                             IsReadOnly="{Binding !StaffViewModel.IsEditing}"
                                             IsHitTestVisible="{Binding StaffViewModel.IsEditing}" Margin="0,2"/>

                                    <TextBlock Grid.Row="3" Grid.Column="0" Text="Docket Name:" VerticalAlignment="Center"/>
                                    <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding StaffViewModel.DocketName}"
                                             Watermark="Shown on receipts - defaults to first name"
                                             IsReadOnly="{Binding !StaffViewModel.IsEditing}"
                                             IsHitTestVisible="{Binding StaffViewModel.IsEditing}" Margin="0,2"/>

                                    <TextBlock Grid.Row="4" Grid.Column="0" Text="Position:" VerticalAlignment="Center"/>
                                    <TextBox Grid.Row="4" Grid.Column="1" Text="{Binding StaffViewModel.Position}"
                                             IsReadOnly="{Binding !StaffViewModel.IsEditing}"
                                             IsHitTestVisible="{Binding StaffViewModel.IsEditing}" Margin="0,2"/>

                                    <TextBlock Grid.Row="5" Grid.Column="0" Text="Date of Birth:" VerticalAlignment="Center"/>
                                    <DatePicker Grid.Row="5" Grid.Column="1" SelectedDate="{Binding StaffViewModel.DateOfBirth}"
                                                IsEnabled="{Binding StaffViewModel.IsEditing}" HorizontalAlignment="Left" Margin="0,2"/>

                                    <TextBlock Grid.Row="6" Grid.Column="0" Text="Administrator:" VerticalAlignment="Center"/>
                                    <CheckBox Grid.Row="6" Grid.Column="1" IsChecked="{Binding StaffViewModel.IsAdministrator}"
                                              IsEnabled="{Binding StaffViewModel.IsEditing}" Margin="0,2"/>

                                    <TextBlock Grid.Row="7" Grid.Column="0" Text="Inactive:" VerticalAlignment="Center"/>
                                    <CheckBox Grid.Row="7" Grid.Column="1" IsChecked="{Binding StaffViewModel.Inactive}"
                                              IsEnabled="{Binding StaffViewModel.IsEditing}" Margin="0,2"/>
                                </Grid>

                                <!-- Address -->
                                <Separator Margin="0,10"/>
                                <TextBlock Text="Address" FontWeight="Bold"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="120"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Address:" VerticalAlignment="Center"/>
                                    <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding StaffViewModel.Address}"
                                             AcceptsReturn="True" Height="60"
                                             IsReadOnly="{Binding !StaffViewModel.IsEditing}"
                                             IsHitTestVisible="{Binding StaffViewModel.IsEditing}" Margin="0,2"/>

                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Suburb:" VerticalAlignment="Center"/>
                                    <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding StaffViewModel.Suburb}"
                                             IsReadOnly="{Binding !StaffViewModel.IsEditing}"
                                             IsHitTestVisible="{Binding StaffViewModel.IsEditing}" Margin="0,2"/>

                                    <TextBlock Grid.Row="2" Grid.Column="0" Text="State:" VerticalAlignment="Center"/>
                                    <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding StaffViewModel.State}"
                                             IsReadOnly="{Binding !StaffViewModel.IsEditing}"
                                             IsHitTestVisible="{Binding StaffViewModel.IsEditing}" Margin="0,2"/>

                                    <TextBlock Grid.Row="3" Grid.Column="0" Text="Postcode:" VerticalAlignment="Center"/>
                                    <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding StaffViewModel.Postcode}"
                                             IsReadOnly="{Binding !StaffViewModel.IsEditing}"
                                             IsHitTestVisible="{Binding StaffViewModel.IsEditing}" Margin="0,2"/>
                                </Grid>

                                <!-- Contact -->
                                <Separator Margin="0,10"/>
                                <TextBlock Text="Contact" FontWeight="Bold"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="120"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Home Phone:" VerticalAlignment="Center"/>
                                    <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding StaffViewModel.HomePhone}"
                                             IsReadOnly="{Binding !StaffViewModel.IsEditing}"
                                             IsHitTestVisible="{Binding StaffViewModel.IsEditing}" Margin="0,2"/>

                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Mobile:" VerticalAlignment="Center"/>
                                    <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding StaffViewModel.Mobile}"
                                             IsReadOnly="{Binding !StaffViewModel.IsEditing}"
                                             IsHitTestVisible="{Binding StaffViewModel.IsEditing}" Margin="0,2"/>

                                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Email:" VerticalAlignment="Center"/>
                                    <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding StaffViewModel.EmailAddress}"
                                             IsReadOnly="{Binding !StaffViewModel.IsEditing}"
                                             IsHitTestVisible="{Binding StaffViewModel.IsEditing}" Margin="0,2"/>
                                </Grid>

                                <!-- Login -->
                                <Separator Margin="0,10"/>
                                <TextBlock Text="Login (used by JobMatix Tracking, not the till barcode above)" FontWeight="Bold"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="120"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Password:" VerticalAlignment="Center"/>
                                    <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding StaffViewModel.Password}"
                                             PasswordChar="*"
                                             IsReadOnly="{Binding !StaffViewModel.IsEditing}"
                                             IsHitTestVisible="{Binding StaffViewModel.IsEditing}" Margin="0,2"/>

                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Password Hint:" VerticalAlignment="Center"/>
                                    <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding StaffViewModel.PasswordHint}"
                                             IsReadOnly="{Binding !StaffViewModel.IsEditing}"
                                             IsHitTestVisible="{Binding StaffViewModel.IsEditing}" Margin="0,2"/>

                                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Status:" VerticalAlignment="Center"/>
                                    <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding StaffViewModel.Status}"
                                             IsReadOnly="{Binding !StaffViewModel.IsEditing}"
                                             IsHitTestVisible="{Binding StaffViewModel.IsEditing}" Margin="0,2"/>
                                </Grid>

                                <!-- Action Buttons -->
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0"
                                            IsVisible="{Binding StaffViewModel.IsEditing}">
                                    <Button Content="Save" Width="100" Margin="0,0,10,0"
                                            Command="{Binding StaffViewModel.SaveStaffCommand}"
                                            Background="Green" Foreground="White"/>
                                    <Button Content="Cancel" Width="100"
                                            Command="{Binding StaffViewModel.CancelEditCommand}"/>
                                </StackPanel>
                            </StackPanel>
                        </ScrollViewer>
                    </Border>

                    <!-- SMS Settings (DirectSMS - the only gateway the legacy app ever
                         actually had configured) - operational config, lives here rather
                         than a dedicated settings screen (none exists yet). -->
                    <Border Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" Margin="0,10,0,0" Padding="10"
                            Background="#F5F5F5" BorderBrush="Gray" BorderThickness="1">
                        <StackPanel Spacing="6">
                            <TextBlock Text="SMS Settings (DirectSMS)" FontWeight="Bold"/>
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBox Width="150" Watermark="Username" Text="{Binding StaffViewModel.SmsUsername}"/>
                                <TextBox Width="150" Watermark="Password" PasswordChar="*" Text="{Binding StaffViewModel.SmsPassword}"/>
                                <TextBox Width="120" Watermark="From/sender" Text="{Binding StaffViewModel.SmsFromNumber}"/>
                                <Button Content="Save" Command="{Binding StaffViewModel.SaveSmsSettingsCommand}"/>
                                <TextBlock Text="{Binding StaffViewModel.SmsSettingsStatusMessage}" VerticalAlignment="Center" FontStyle="Italic"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Email (SMTP) Settings -->
                    <Border Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="2" Margin="0,10,0,0" Padding="10"
                            Background="#F5F5F5" BorderBrush="Gray" BorderThickness="1">
                        <StackPanel Spacing="6">
                            <TextBlock Text="Email Settings (SMTP)" FontWeight="Bold"/>
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBox Width="150" Watermark="Host" Text="{Binding StaffViewModel.EmailHost}"/>
                                <NumericUpDown Width="90" Minimum="1" Maximum="65535" FormatString="0" Value="{Binding StaffViewModel.EmailPort}"/>
                                <CheckBox Content="SSL" IsChecked="{Binding StaffViewModel.EmailUseSsl}"/>
                                <TextBox Width="150" Watermark="Username" Text="{Binding StaffViewModel.EmailUsername}"/>
                                <TextBox Width="150" Watermark="Password" PasswordChar="*" Text="{Binding StaffViewModel.EmailPassword}"/>
                                <TextBox Width="180" Watermark="From address" Text="{Binding StaffViewModel.EmailFromAddress}"/>
                                <Button Content="Save" Command="{Binding StaffViewModel.SaveEmailSettingsCommand}"/>
                                <TextBlock Text="{Binding StaffViewModel.EmailSettingsStatusMessage}" VerticalAlignment="Center" FontStyle="Italic"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Status Message -->
                    <TextBlock Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="2"
                               Text="{Binding StaffViewModel.StatusMessage}"
                               Margin="0,10,0,0" FontStyle="Italic"/>
                </Grid>

                <!-- Manager override - Staff admin requires an administrator's barcode at
                     the point of access, independent of whoever is attributed to sales. -->
                <Border IsVisible="{Binding !IsStaffAdminUnlocked}" Background="#F5F5F5">
                    <Border Width="380" Padding="30" HorizontalAlignment="Center" VerticalAlignment="Center"
                            Background="White" BorderBrush="Gray" BorderThickness="1" CornerRadius="6">
                        <StackPanel Spacing="14">
                            <TextBlock Text="Manager Override Required" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center"/>
                            <TextBlock Text="Enter an administrator's staff barcode/number to access Staff Admin" Foreground="Gray"
                                       HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center"/>
                            <TextBox Name="txtStaffOverrideBarcode" Text="{Binding StaffOverrideBarcode}"
                                     Watermark="Admin barcode/number" FontSize="16" HorizontalContentAlignment="Center"/>
                            <Button Content="Unlock" Command="{Binding UnlockStaffAdminCommand}"
                                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                                    Background="#2E7D32" Foreground="White"/>
                            <TextBlock Text="{Binding StaffOverrideStatusMessage}" Foreground="Crimson"
                                       HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center"/>
                        </StackPanel>
                    </Border>
                </Border>
              </Panel>
            </TabItem>

            <!-- Reports Tab -->
            <TabItem Header="Reports" Classes="navhidden">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Report Selection and Date Range -->
                    <StackPanel Grid.Row="0" Orientation="Vertical" Margin="0,0,0,10">
                        <TextBlock Text="Report Type" FontWeight="Bold" Margin="0,0,0,5"/>
                        <WrapPanel Orientation="Horizontal" ItemSpacing="10" LineSpacing="6">
                            <Button Content="Daily Sales" Command="{Binding ReportsViewModel.RunDailySalesReportCommand}" Width="120"/>
                            <Button Content="Stock Value" Command="{Binding ReportsViewModel.RunStockValueReportCommand}" Width="120"/>
                            <Button Content="Low Stock" Command="{Binding ReportsViewModel.RunLowStockReportCommand}" Width="120"/>
                            <Button Content="Customer Accounts" Command="{Binding ReportsViewModel.RunCustomerAccountsReportCommand}" Width="140"/>
                            <Button Content="Top Customers" Command="{Binding ReportsViewModel.RunTopCustomersReportCommand}" Width="130"/>
                            <Button Content="Top Products" Command="{Binding ReportsViewModel.RunTopProductsReportCommand}" Width="120"/>
                            <Button Content="Cost / Margin" Command="{Binding ReportsViewModel.RunCostMarginReportCommand}" Width="120"/>
                            <Button Content="Jobs" Command="{Binding ReportsViewModel.RunJobsReportCommand}" Width="100"/>
                            <Button Content="Parts" Command="{Binding ReportsViewModel.RunPartsReportCommand}" Width="100"/>
                            <Button Content="Staff" Command="{Binding ReportsViewModel.RunStaffReportCommand}" Width="100"/>
                            <Button Content="Timesheet" Command="{Binding ReportsViewModel.RunTimesheetReportCommand}" Width="110"/>
                            <Button Content="Cash Up" Command="{Binding ReportsViewModel.LoadCashupCommand}" Width="120" Background="#2E7D32" Foreground="White"/>
                        </WrapPanel>

                        <!-- Date Range Selection -->
                        <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,10,0,0">
                            <TextBlock Text="From:" VerticalAlignment="Center"/>
                            <DatePicker SelectedDate="{Binding ReportsViewModel.StartDate}" Width="150"/>
                            <TextBlock Text="To:" VerticalAlignment="Center" Margin="10,0,0,0"/>
                            <DatePicker SelectedDate="{Binding ReportsViewModel.EndDate}" Width="150"/>
                        </StackPanel>

                        <!-- Customer Statement -->
                        <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,10,0,0">
                            <TextBlock Text="Customer barcode:" VerticalAlignment="Center"/>
                            <TextBox Text="{Binding ReportsViewModel.StatementCustomerBarcode}" Width="150" Watermark="Barcode/number"/>
                            <Button Content="Customer Statement" Command="{Binding ReportsViewModel.RunCustomerStatementCommand}" Width="160"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- Report Title -->
                    <TextBlock Grid.Row="1" 
                               Text="{Binding ReportsViewModel.ReportTitle}" 
                               FontSize="18" 
                               FontWeight="Bold" 
                               Margin="0,0,0,10"/>

                    <!-- Cash Up panel -->
                    <Border Grid.Row="2" BorderBrush="#CCCCCC" BorderThickness="1" Padding="15"
                            IsVisible="{Binding ReportsViewModel.IsCashupView}">
                        <StackPanel Spacing="10">
                            <Grid ColumnDefinitions="Auto,120,20,Auto,*">
                                <TextBlock Grid.Column="0" Text="Till:" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                <TextBox Grid.Column="1" Text="{Binding ReportsViewModel.CashupTill}"/>
                                <TextBlock Grid.Column="3" Text="Since:" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                <TextBlock Grid.Column="4" Text="{Binding ReportsViewModel.CashupPeriodStart, StringFormat='{}{0:dd-MMM-yyyy HH:mm}'}" VerticalAlignment="Center"/>
                            </Grid>

                            <Border BorderBrush="Gray" BorderThickness="1">
                                <Grid RowDefinitions="Auto,*">
                                    <Grid Grid.Row="0" Background="LightGray" ColumnDefinitions="*,150,150,150">
                                        <TextBlock Grid.Column="0" Text="Payment Method" Margin="5" FontWeight="Bold"/>
                                        <TextBlock Grid.Column="1" Text="Reported" Margin="5" FontWeight="Bold" HorizontalAlignment="Right"/>
                                        <TextBlock Grid.Column="2" Text="Counted" Margin="5" FontWeight="Bold" HorizontalAlignment="Right"/>
                                        <TextBlock Grid.Column="3" Text="Variance" Margin="5" FontWeight="Bold" HorizontalAlignment="Right"/>
                                    </Grid>
                                    <ListBox Grid.Row="1" ItemsSource="{Binding ReportsViewModel.CashupLines}" Height="200">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <Grid ColumnDefinitions="*,150,150,150" Margin="5,3">
                                                    <TextBlock Grid.Column="0" Text="{Binding PaymentMethod}" VerticalAlignment="Center"/>
                                                    <TextBlock Grid.Column="1" Text="{Binding Reported, StringFormat=C}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                                    <TextBox Grid.Column="2" Text="{Binding Counted}" HorizontalContentAlignment="Right"/>
                                                    <TextBlock Grid.Column="3" Text="{Binding Variance, StringFormat=C}" HorizontalAlignment="Right" VerticalAlignment="Center"
                                                               Foreground="Crimson"/>
                                                </Grid>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                </Grid>
                            </Border>

                            <Grid ColumnDefinitions="*,150,150,150">
                                <TextBlock Grid.Column="0" Text="Total" FontWeight="Bold" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1" Text="{Binding ReportsViewModel.CashupTotalReported, StringFormat=C}" FontWeight="Bold" HorizontalAlignment="Right"/>
                                <TextBlock Grid.Column="2" Text="{Binding ReportsViewModel.CashupTotalCounted, StringFormat=C}" FontWeight="Bold" HorizontalAlignment="Right"/>
                                <TextBlock Grid.Column="3" Text="{Binding ReportsViewModel.CashupTotalVariance, StringFormat=C}" FontWeight="Bold" HorizontalAlignment="Right" Foreground="Crimson"/>
                            </Grid>

                            <Grid ColumnDefinitions="Auto,200,20,Auto,*" Margin="0,10,0,0">
                                <TextBlock Grid.Column="0" Text="Staff:" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                <TextBox Grid.Column="1" Name="txtCashupStaffBarcode" Text="{Binding ReportsViewModel.CashupStaffBarcode}" Watermark="Barcode/number"/>
                                <TextBlock Grid.Column="3" Text="Comments:" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                <TextBox Grid.Column="4" Text="{Binding ReportsViewModel.CashupComments}"/>
                            </Grid>

                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <Button Content="Complete Cash Up" Command="{Binding ReportsViewModel.CompleteCashupCommand}" Background="#2E7D32" Foreground="White" Width="150"/>
                                <TextBlock Text="{Binding ReportsViewModel.CashupStatusMessage}" VerticalAlignment="Center" FontStyle="Italic"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Report Data Grid -->
                    <Border Grid.Row="2" BorderBrush="#CCCCCC" BorderThickness="1"
                            IsVisible="{Binding !ReportsViewModel.IsCashupView}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            
                            <!-- Header Row -->
                            <Grid Grid.Row="0" Background="LightGray" Margin="0,0,0,2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="2*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Column 1" Margin="5" FontWeight="Bold"/>
                                <TextBlock Grid.Column="1" Text="Column 2" Margin="5" FontWeight="Bold"/>
                                <TextBlock Grid.Column="2" Text="Column 3" Margin="5" FontWeight="Bold"/>
                                <TextBlock Grid.Column="3" Text="Column 4" Margin="5" FontWeight="Bold"/>
                            </Grid>
                            
                            <!-- Data ListBox -->
                            <ListBox Grid.Row="1" 
                                     ItemsSource="{Binding ReportsViewModel.ReportData}"
                                     Background="White">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="LightGray" BorderThickness="0,0,0,1" Padding="5">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="2*"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="{Binding Column1}" Margin="5,0"/>
                                                <TextBlock Grid.Column="1" Text="{Binding Column2}" Margin="5,0"/>
                                                <TextBlock Grid.Column="2" Text="{Binding Column3}" Margin="5,0"/>
                                                <TextBlock Grid.Column="3" Text="{Binding Column4}" Margin="5,0"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Grid>
                    </Border>

                    <!-- Summary Panel -->
                    <Border Grid.Row="3"
                            Background="#F0F0F0"
                            BorderBrush="#CCCCCC"
                            BorderThickness="1"
                            Padding="10"
                            Margin="0,10,0,0"
                            IsVisible="{Binding !ReportsViewModel.IsCashupView}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="5">
                                <TextBlock Text="{Binding ReportsViewModel.Summary1Label}" FontWeight="Bold"/>
                                <TextBlock Text="{Binding ReportsViewModel.Summary1Value}"/>
                            </StackPanel>

                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="5">
                                <TextBlock Text="{Binding ReportsViewModel.Summary2Label}" FontWeight="Bold"/>
                                <TextBlock Text="{Binding ReportsViewModel.Summary2Value}"/>
                            </StackPanel>

                            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="5">
                                <TextBlock Text="{Binding ReportsViewModel.Summary3Label}" FontWeight="Bold"/>
                                <TextBlock Text="{Binding ReportsViewModel.Summary3Value}"/>
                            </StackPanel>

                            <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="5">
                                <TextBlock Text="{Binding ReportsViewModel.Summary4Label}" FontWeight="Bold"/>
                                <TextBlock Text="{Binding ReportsViewModel.Summary4Value}"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Action Buttons and Status -->
                    <StackPanel Grid.Row="4" Orientation="Horizontal" Spacing="10" Margin="0,10,0,0"
                                IsVisible="{Binding !ReportsViewModel.IsCashupView}">
                        <Button Content="Export to CSV" Command="{Binding ReportsViewModel.ExportReportCommand}" Width="120"/>
                        <Button Content="Print" Command="{Binding ReportsViewModel.PrintReportCommand}" Width="100"/>
                        <TextBlock Text="{Binding ReportsViewModel.StatusMessage}" 
                                   VerticalAlignment="Center" 
                                   Margin="20,0,0,0"
                                   Foreground="Green"/>
                    </StackPanel>
                </Grid>
            </TabItem>

            <!-- Transactions Tab -->
            <TabItem Header="Transactions" Classes="navhidden">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Search Filters -->
                    <Border Grid.Row="0" BorderBrush="Gray" BorderThickness="1" Padding="10" Margin="0,0,0,10">
                        <StackPanel>
                            <TextBlock Text="Transaction Lookup" FontWeight="Bold" FontSize="16" Margin="0,0,0,10"/>
                            
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="150"/>
                                    <ColumnDefinition Width="20"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="10"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="10"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <!-- Type Selection -->
                                <TextBlock Grid.Row="0" Grid.Column="0" Text="Type:" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                <ComboBox Grid.Row="0" Grid.Column="1" SelectedItem="{Binding TransactionLookupViewModel.LookupType}">
                                    <ComboBoxItem Content="Invoice"/>
                                    <ComboBoxItem Content="Payment"/>
                                    <ComboBoxItem Content="Quote"/>
                                </ComboBox>

                                <TextBlock Grid.Row="0" Grid.Column="3" Text="Period:" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                <ComboBox Grid.Row="0" Grid.Column="4" SelectedItem="{Binding TransactionLookupViewModel.DatePeriod}" HorizontalAlignment="Left" Width="150">
                                    <ComboBoxItem Content="Today"/>
                                    <ComboBoxItem Content="ThisMonth"/>
                                    <ComboBoxItem Content="12Months"/>
                                    <ComboBoxItem Content="Any" IsSelected="True"/>
                                    <ComboBoxItem Content="Custom"/>
                                </ComboBox>

                                <!-- Staff Filter -->
                                <TextBlock Grid.Row="2" Grid.Column="0" Text="Staff:" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding TransactionLookupViewModel.StaffBarcode}" Watermark="Staff barcode"/>

                                <!-- Customer Filter -->
                                <TextBlock Grid.Row="2" Grid.Column="3" Text="Customer:" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                <TextBox Grid.Row="2" Grid.Column="4" Text="{Binding TransactionLookupViewModel.CustomerBarcode}" Watermark="Customer barcode"/>

                                <!-- Item Filter -->
                                <TextBlock Grid.Row="4" Grid.Column="0" Text="Item:" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                <TextBox Grid.Row="4" Grid.Column="1" Text="{Binding TransactionLookupViewModel.ItemBarcode}" Watermark="Item barcode"/>

                                <!-- Serial Filter -->
                                <TextBlock Grid.Row="4" Grid.Column="3" Text="Serial:" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                <TextBox Grid.Row="4" Grid.Column="4" Text="{Binding TransactionLookupViewModel.SerialNumber}" Watermark="Serial number (warranty lookup)" HorizontalAlignment="Left" Width="250"/>
                            </Grid>
                            <Grid Margin="0,10,0,0">
                                <!-- Buttons -->
                                <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                                    <Button Content="Search" Command="{Binding TransactionLookupViewModel.SearchCommand}" Width="80" Margin="0,0,10,0"/>
                                    <Button Content="Clear" Command="{Binding TransactionLookupViewModel.ClearFiltersCommand}" Width="80"/>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Results List -->
                    <Border Grid.Row="1" BorderBrush="Gray" BorderThickness="1">
                        <ListBox ItemsSource="{Binding TransactionLookupViewModel.Transactions}"
                                SelectedItem="{Binding TransactionLookupViewModel.SelectedTransaction}">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="LightGray" BorderThickness="0,0,0,1" Padding="5">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="50"/>
                                                <ColumnDefinition Width="140"/>
                                                <ColumnDefinition Width="100"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="150"/>
                                                <ColumnDefinition Width="100"/>
                                                <ColumnDefinition Width="150"/>
                                                <ColumnDefinition Width="70"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{Binding TransactionId}" Margin="5,0" FontWeight="Bold"/>
                                            <TextBlock Grid.Column="1" Text="{Binding DisplayDate}" Margin="5,0"/>
                                            <TextBlock Grid.Column="2" Text="{Binding DisplayType}" Margin="5,0" Foreground="DarkBlue"/>
                                            <TextBlock Grid.Column="3" Text="{Binding InvoiceNumber}" Margin="5,0"/>
                                            <TextBlock Grid.Column="4" Text="{Binding CustomerName}" Margin="5,0"/>
                                            <TextBlock Grid.Column="5" Text="{Binding DisplayAmount}" Margin="5,0" HorizontalAlignment="Right" FontWeight="Bold"/>
                                            <TextBlock Grid.Column="6" Text="{Binding StaffName}" Margin="5,0"/>
                                            <TextBlock Grid.Column="7" Text="VOIDED" Margin="5,0" FontWeight="Bold" Foreground="Crimson"
                                                       IsVisible="{Binding Status, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Border>

                    <!-- Action Buttons -->
                    <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,10,0,0">
                        <Button Content="View/Print Invoice" Command="{Binding TransactionLookupViewModel.ViewTransactionCommand}" Width="150" Margin="0,0,10,0"/>
                        <Button Content="Print Receipt" Command="{Binding TransactionLookupViewModel.PrintTransactionCommand}" Width="120" Margin="0,0,10,0"/>
                        <Button Content="Void" Command="{Binding TransactionLookupViewModel.RequestVoidCommand}" Width="100" Margin="0,0,10,0"
                                Background="Crimson" Foreground="White"/>
                        <TextBlock Text="{Binding TransactionLookupViewModel.StatusMessage}" VerticalAlignment="Center" Margin="20,0,0,0" FontStyle="Italic"/>
                    </StackPanel>

                    <!-- Void manager override - same pattern as Staff admin: checked at the
                         point of use, not tied to any persistent signed-in session. -->
                    <Border Grid.Row="3" Margin="0,10,0,0" Padding="10" Background="#FFF3E0" BorderBrush="Crimson" BorderThickness="1" CornerRadius="4"
                            IsVisible="{Binding TransactionLookupViewModel.IsVoidPromptOpen}">
                        <StackPanel Spacing="8">
                            <TextBlock Text="{Binding TransactionLookupViewModel.SelectedTransaction.TransactionId, StringFormat='Void transaction #{0} - requires an admin barcode'}" FontWeight="Bold"/>
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBox Name="txtVoidOverrideBarcode" Width="220" Watermark="Admin barcode/number"
                                         Text="{Binding TransactionLookupViewModel.VoidOverrideBarcode}"/>
                                <Button Content="Confirm Void" Command="{Binding TransactionLookupViewModel.ConfirmVoidCommand}" Background="Crimson" Foreground="White"/>
                                <Button Content="Cancel" Command="{Binding TransactionLookupViewModel.CancelVoidCommand}"/>
                                <TextBlock Text="{Binding TransactionLookupViewModel.VoidStatusMessage}" Foreground="Crimson" VerticalAlignment="Center"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </Grid>
            </TabItem>

            <!-- Stocktake Tab -->
            <TabItem Header="Stocktake" Classes="navhidden">
                <Grid Margin="10" ColumnDefinitions="1.3*,2*">
                    <!-- Sessions list -->
                    <Grid Grid.Column="0" Margin="0,0,10,0" RowDefinitions="Auto,Auto,*">
                        <TextBlock Grid.Row="0" Text="Open Stocktakes" FontWeight="Bold" FontSize="16" Margin="0,0,0,10"/>
                        <StackPanel Grid.Row="1" Spacing="6" Margin="0,0,0,10">
                            <TextBox Text="{Binding StocktakeViewModel.StaffBarcode}" Watermark="Your staff barcode"/>
                            <Button Content="+ New Stocktake" Command="{Binding StocktakeViewModel.NewStocktakeCommand}" HorizontalAlignment="Stretch"/>
                        </StackPanel>
                        <Border Grid.Row="2" BorderBrush="Gray" BorderThickness="1">
                            <ListBox ItemsSource="{Binding StocktakeViewModel.Sessions}"
                                     SelectedItem="{Binding StocktakeViewModel.SelectedSession}">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Summary}" Margin="5"/>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Border>
                    </Grid>

                    <!-- Selected session detail -->
                    <Grid Grid.Column="1" IsVisible="{Binding StocktakeViewModel.HasOpenSession}" RowDefinitions="Auto,*,Auto,Auto">
                        <TextBox Grid.Row="0" Text="{Binding StocktakeViewModel.ScanBarcode}"
                                 Watermark="Scan barcode - counts one more unit each time" Margin="0,0,0,10">
                            <TextBox.KeyBindings>
                                <KeyBinding Gesture="Enter" Command="{Binding StocktakeViewModel.ScanItemCommand}"/>
                            </TextBox.KeyBindings>
                        </TextBox>

                        <Border Grid.Row="1" BorderBrush="Gray" BorderThickness="1">
                            <DockPanel>
                                <Border DockPanel.Dock="Top" Background="#F0F0F0" Padding="5">
                                    <Grid ColumnDefinitions="*,Auto,Auto,Auto">
                                        <TextBlock Grid.Column="0" Text="Description" FontWeight="Bold"/>
                                        <TextBlock Grid.Column="1" Text="On Record" FontWeight="Bold" Width="90" HorizontalAlignment="Right"/>
                                        <TextBlock Grid.Column="2" Text="Counted" FontWeight="Bold" Width="90" HorizontalAlignment="Right"/>
                                        <TextBlock Grid.Column="3" Text="Diff" FontWeight="Bold" Width="70" HorizontalAlignment="Right"/>
                                    </Grid>
                                </Border>
                                <ListBox ItemsSource="{Binding StocktakeViewModel.Items}">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Grid ColumnDefinitions="*,Auto,Auto,Auto">
                                                <TextBlock Grid.Column="0" Text="{Binding Description}"/>
                                                <TextBlock Grid.Column="1" Text="{Binding QtyOnRecord}" Width="90" HorizontalAlignment="Right"/>
                                                <TextBlock Grid.Column="2" Text="{Binding QtyCounted}" Width="90" HorizontalAlignment="Right"/>
                                                <TextBlock Grid.Column="3" Text="{Binding QtyDifference}" Width="70" HorizontalAlignment="Right"
                                                           Foreground="Crimson"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </DockPanel>
                        </Border>

                        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,10,0,0" Spacing="10">
                            <Button Content="Commit Stocktake" Command="{Binding StocktakeViewModel.CommitStocktakeCommand}" Background="ForestGreen" Foreground="White"/>
                            <Button Content="Cancel Stocktake" Command="{Binding StocktakeViewModel.CancelStocktakeCommand}"/>
                        </StackPanel>
                        <TextBlock Grid.Row="3" Text="{Binding StocktakeViewModel.StatusMessage}" FontStyle="Italic" Margin="0,10,0,0"/>
                    </Grid>

                    <TextBlock Grid.Column="1" Text="Start a new stocktake, or select an open one from the list, to begin scanning."
                               IsVisible="{Binding !StocktakeViewModel.HasOpenSession}" Foreground="Gray" Margin="10"/>
                </Grid>
            </TabItem>

            <!-- Goods Received Tab -->
            <TabItem Header="Intake" Classes="navhidden">
                <Grid Margin="10" ColumnDefinitions="1.4*,2*">
                    <!-- New receipt -->
                    <Grid Grid.Column="0" Margin="0,0,10,0" RowDefinitions="Auto,*,Auto">
                        <TextBlock Grid.Row="0" Text="Receive Goods" FontWeight="Bold" FontSize="16" Margin="0,0,0,10"/>

                        <StackPanel Grid.Row="1" Spacing="8">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBox Text="{Binding GoodsReceivedViewModel.SupplierBarcode}" Watermark="Supplier barcode" Width="150">
                                    <TextBox.KeyBindings>
                                        <KeyBinding Gesture="Enter" Command="{Binding GoodsReceivedViewModel.LookupSupplierCommand}"/>
                                    </TextBox.KeyBindings>
                                </TextBox>
                                <Button Content="Find" Command="{Binding GoodsReceivedViewModel.LookupSupplierCommand}"/>
                                <TextBlock Text="{Binding GoodsReceivedViewModel.SelectedSupplier.SupplierName}" VerticalAlignment="Center" FontWeight="Bold"/>
                            </StackPanel>

                            <TextBox Text="{Binding GoodsReceivedViewModel.InvoiceNo}" Watermark="Supplier invoice number"/>
                            <DatePicker SelectedDate="{Binding GoodsReceivedViewModel.InvoiceDate}"/>
                            <TextBox Text="{Binding GoodsReceivedViewModel.Comments}" Watermark="Comments (optional)" AcceptsReturn="True" Height="60"/>

                            <TextBox Text="{Binding GoodsReceivedViewModel.ScanBarcode}" Watermark="Scan item barcode to add a line" IsEnabled="{Binding GoodsReceivedViewModel.SelectedSupplier, Converter={x:Static ObjectConverters.IsNotNull}}">
                                <TextBox.KeyBindings>
                                    <KeyBinding Gesture="Enter" Command="{Binding GoodsReceivedViewModel.ScanLineCommand}"/>
                                </TextBox.KeyBindings>
                            </TextBox>
                        </StackPanel>

                        <StackPanel Grid.Row="2" Spacing="8" Margin="0,10,0,0">
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Grid.Column="0" Text="Subtotal (ex GST):"/>
                                <TextBlock Grid.Column="1" Text="{Binding GoodsReceivedViewModel.SubtotalEx, StringFormat=C}"/>
                            </Grid>
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Grid.Column="0" Text="Estimated total (inc GST):" FontWeight="Bold"/>
                                <TextBlock Grid.Column="1" Text="{Binding GoodsReceivedViewModel.EstimatedTotalInc, StringFormat=C}" FontWeight="Bold"/>
                            </Grid>
                            <TextBox Text="{Binding GoodsReceivedViewModel.StaffBarcode}" Watermark="Your staff barcode"/>
                            <Button Content="Receive Goods" Command="{Binding GoodsReceivedViewModel.SubmitGoodsReceivedCommand}"
                                    Background="ForestGreen" Foreground="White" HorizontalAlignment="Stretch"/>
                            <TextBlock Text="{Binding GoodsReceivedViewModel.StatusMessage}" FontStyle="Italic"/>
                        </StackPanel>
                    </Grid>

                    <!-- Lines + recent receipts -->
                    <Grid Grid.Column="1" RowDefinitions="*,Auto,150">
                        <Border Grid.Row="0" BorderBrush="Gray" BorderThickness="1">
                            <DockPanel>
                                <Border DockPanel.Dock="Top" Background="#F0F0F0" Padding="5">
                                    <Grid ColumnDefinitions="*,Auto,Auto,Auto,Auto">
                                        <TextBlock Grid.Column="0" Text="Description" FontWeight="Bold"/>
                                        <TextBlock Grid.Column="1" Text="Qty" FontWeight="Bold" Width="60" HorizontalAlignment="Right"/>
                                        <TextBlock Grid.Column="2" Text="Cost (ex)" FontWeight="Bold" Width="90" HorizontalAlignment="Right"/>
                                        <TextBlock Grid.Column="3" Text="Line Total" FontWeight="Bold" Width="90" HorizontalAlignment="Right"/>
                                        <TextBlock Grid.Column="4" Text="" Width="30"/>
                                    </Grid>
                                </Border>
                                <ListBox ItemsSource="{Binding GoodsReceivedViewModel.Lines}">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel>
                                                <Grid ColumnDefinitions="*,Auto,Auto,Auto,Auto">
                                                    <TextBlock Grid.Column="0" Text="{Binding Description}" VerticalAlignment="Center"/>
                                                    <NumericUpDown Grid.Column="1" Value="{Binding Quantity}" Width="90" Minimum="1" FormatString="0"/>
                                                    <NumericUpDown Grid.Column="2" Value="{Binding CostEx}" Width="110" Minimum="0" FormatString="C"/>
                                                    <TextBlock Grid.Column="3" Text="{Binding LineTotalEx, StringFormat=C}" Width="90" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                                    <Button Grid.Column="4" Content="x" Width="30"
                                                            Command="{Binding $parent[Window].DataContext.GoodsReceivedViewModel.RemoveLineCommand}"
                                                            CommandParameter="{Binding}"/>
                                                </Grid>
                                                <!-- Phase 6.1: capture a serial per unit so its cost is stamped onto serial_audit
                                                     at receiving time, instead of only the SKU's overwritten costprice field. -->
                                                <TextBox IsVisible="{Binding RequiresSerial}"
                                                         Text="{Binding SerialNumbersText}"
                                                         Watermark="Serial numbers, one per unit received (comma or newline separated)"
                                                         Margin="0,2,0,6" FontSize="11"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </DockPanel>
                        </Border>

                        <TextBlock Grid.Row="1" Text="Recent Goods Received" FontWeight="Bold" Margin="0,10,0,5"/>
                        <Border Grid.Row="2" BorderBrush="Gray" BorderThickness="1">
                            <ListBox ItemsSource="{Binding GoodsReceivedViewModel.RecentReceipts}">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid ColumnDefinitions="Auto,140,*,Auto" Margin="5,2">
                                            <TextBlock Grid.Column="0" Text="{Binding GoodsId, StringFormat='#{0}'}" FontWeight="Bold" Width="50"/>
                                            <TextBlock Grid.Column="1" Text="{Binding GoodsDate, StringFormat='dd-MMM-yyyy HH:mm'}"/>
                                            <TextBlock Grid.Column="2" Text="{Binding SupplierName}"/>
                                            <TextBlock Grid.Column="3" Text="{Binding TotalInc, StringFormat=C}" FontWeight="Bold"/>
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Border>
                    </Grid>
                </Grid>
            </TabItem>

            <!-- Return Authorisations Tab -->
            <TabItem Header="Returns" Classes="navhidden">
                <Grid Margin="10" ColumnDefinitions="1.3*,2*">
                    <!-- New RA form -->
                    <Grid Grid.Column="0" Margin="0,0,10,0" RowDefinitions="Auto,*">
                        <TextBlock Grid.Row="0" Text="New Return Authorisation" FontWeight="Bold" FontSize="16" Margin="0,0,0,10"/>
                        <StackPanel Grid.Row="1" Spacing="8">
                            <ComboBox SelectedItem="{Binding ReturnAuthorizationViewModel.NewOrigin}" HorizontalAlignment="Stretch">
                                <ComboBoxItem Content="Counter"/>
                                <ComboBoxItem Content="Stock"/>
                                <ComboBoxItem Content="Job"/>
                            </ComboBox>
                            <TextBox Text="{Binding ReturnAuthorizationViewModel.NewCustomerBarcode}" Watermark="Customer barcode (optional)"/>
                            <TextBox Text="{Binding ReturnAuthorizationViewModel.NewSupplierBarcode}" Watermark="Supplier barcode"/>
                            <TextBox Text="{Binding ReturnAuthorizationViewModel.NewItemBarcode}" Watermark="Item barcode (optional - links to stock)"/>
                            <TextBox Text="{Binding ReturnAuthorizationViewModel.NewItemDescription}" Watermark="Item description"/>
                            <TextBox Text="{Binding ReturnAuthorizationViewModel.NewSerialNumber}" Watermark="Serial number (optional)"/>
                            <TextBox Text="{Binding ReturnAuthorizationViewModel.NewProblemDescription}" Watermark="Problem description" AcceptsReturn="True" Height="60"/>
                            <TextBox Text="{Binding ReturnAuthorizationViewModel.NewSymptoms}" Watermark="Symptoms"/>
                            <TextBox Text="{Binding ReturnAuthorizationViewModel.NewStaffBarcode}" Watermark="Your staff barcode"/>
                            <Button Content="Create RA" Command="{Binding ReturnAuthorizationViewModel.CreateRaCommand}" Background="ForestGreen" Foreground="White" HorizontalAlignment="Stretch"/>
                            <TextBlock Text="{Binding ReturnAuthorizationViewModel.StatusMessage}" FontStyle="Italic"/>
                        </StackPanel>
                    </Grid>

                    <!-- Open RAs + action panel -->
                    <Grid Grid.Column="1" RowDefinitions="2*,Auto">
                        <Border Grid.Row="0" BorderBrush="Gray" BorderThickness="1">
                            <ListBox ItemsSource="{Binding ReturnAuthorizationViewModel.OpenRAs}"
                                     SelectedItem="{Binding ReturnAuthorizationViewModel.SelectedRa}">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid ColumnDefinitions="50,*,140,*,140" Margin="5,3">
                                            <TextBlock Grid.Column="0" Text="{Binding RaId, StringFormat='#{0}'}" FontWeight="Bold"/>
                                            <TextBlock Grid.Column="1" Text="{Binding ItemDescription}"/>
                                            <TextBlock Grid.Column="2" Text="{Binding SupplierName}"/>
                                            <TextBlock Grid.Column="3" Text="{Binding Origin}"/>
                                            <TextBlock Grid.Column="4" Text="{Binding RaStatus}" FontWeight="Bold"/>
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Border>

                        <Border Grid.Row="1" Margin="0,10,0,0" Padding="10" Background="#F5F5F5" BorderBrush="Gray" BorderThickness="1"
                                IsVisible="{Binding ReturnAuthorizationViewModel.SelectedRa, Converter={x:Static ObjectConverters.IsNotNull}}">
                            <StackPanel Spacing="8">
                                <TextBlock Text="{Binding ReturnAuthorizationViewModel.SelectedRa.Summary}" FontWeight="Bold"/>

                                <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding ReturnAuthorizationViewModel.CanRequestFromSupplier}">
                                    <TextBox Width="300" Watermark="Request notes" Text="{Binding ReturnAuthorizationViewModel.ActionNotes}"/>
                                    <Button Content="Request from Supplier" Command="{Binding ReturnAuthorizationViewModel.RequestFromSupplierCommand}"/>
                                </StackPanel>

                                <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding ReturnAuthorizationViewModel.CanGrantRma}">
                                    <TextBox Width="300" Watermark="Supplier RMA number" Text="{Binding ReturnAuthorizationViewModel.ActionNotes}"/>
                                    <Button Content="Record RMA Granted" Command="{Binding ReturnAuthorizationViewModel.GrantRmaCommand}"/>
                                </StackPanel>

                                <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding ReturnAuthorizationViewModel.CanSendToSupplier}">
                                    <TextBox Width="200" Watermark="Courier barcode" Text="{Binding ReturnAuthorizationViewModel.ActionCourierBarcode}"/>
                                    <TextBox Width="150" Watermark="Your staff barcode" Text="{Binding ReturnAuthorizationViewModel.ActionStaffBarcode}"/>
                                    <Button Content="Send to Supplier" Command="{Binding ReturnAuthorizationViewModel.SendToSupplierCommand}"/>
                                </StackPanel>

                                <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding ReturnAuthorizationViewModel.CanComplete}">
                                    <ComboBox SelectedItem="{Binding ReturnAuthorizationViewModel.ActionReturnResult}" Width="130">
                                        <ComboBoxItem Content="Replaced"/>
                                        <ComboBoxItem Content="Repaired"/>
                                        <ComboBoxItem Content="Returned"/>
                                        <ComboBoxItem Content="Credited"/>
                                        <ComboBoxItem Content="Other"/>
                                    </ComboBox>
                                    <TextBox Width="220" Watermark="Comment" Text="{Binding ReturnAuthorizationViewModel.ActionNotes}"/>
                                    <CheckBox Content="Goods received back" IsChecked="{Binding ReturnAuthorizationViewModel.ActionGoodsReceivedBack}"/>
                                    <Button Content="Complete" Command="{Binding ReturnAuthorizationViewModel.CompleteRaCommand}" Background="ForestGreen" Foreground="White"/>
                                </StackPanel>

                                <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding ReturnAuthorizationViewModel.CanCloseOut}">
                                    <Button Content="Refuse" Command="{Binding ReturnAuthorizationViewModel.RefuseRaCommand}" Background="Crimson" Foreground="White"/>
                                    <Button Content="Cancel RA" Command="{Binding ReturnAuthorizationViewModel.CancelRaCommand}"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Grid>
            </TabItem>

            <!-- Jobs Tab -->
            <TabItem Header="Tickets">
                <Grid Margin="10">
                <!-- List mode: New Ticket intake + search/grouped list. Hidden entirely
                     while viewing a ticket, per direct feedback (2026-09-01) - the detail
                     view should get the whole tab, not just the right-hand column. -->
                <Grid ColumnDefinitions="1.2*,2*" IsVisible="{Binding !JobViewModel.IsViewingTicket}">
                    <!-- New job intake -->
                    <ScrollViewer Grid.Column="0" Margin="0,0,10,0">
                        <StackPanel Spacing="8">
                            <TextBlock Text="New Job" FontWeight="Bold" FontSize="16" Margin="0,0,0,5"/>
                            <TextBox Text="{Binding JobViewModel.NewCustomerBarcode}" Watermark="Customer barcode (optional)"/>
                            <TextBox Text="{Binding JobViewModel.NewGoodsInCare}" Watermark="Goods in care"/>
                            <TextBox Text="{Binding JobViewModel.NewGoodsBrand}" Watermark="Brand"/>
                            <TextBox Text="{Binding JobViewModel.NewGoodsModel}" Watermark="Model"/>
                            <ComboBox SelectedItem="{Binding JobViewModel.NewPriority}" HorizontalAlignment="Stretch">
                                <ComboBoxItem Content="H"/>
                                <ComboBoxItem Content="B"/>
                            </ComboBox>
                            <TextBox Text="{Binding JobViewModel.NewProblemShort}" Watermark="Problem (short)"/>
                            <TextBox Text="{Binding JobViewModel.NewProblemLong}" Watermark="Problem (details)" AcceptsReturn="True" Height="60"/>
                            <TextBox Text="{Binding JobViewModel.NewSymptoms}" Watermark="Symptoms"/>
                            <CheckBox Content="Data backup required" IsChecked="{Binding JobViewModel.NewDataBackupReqd}"/>
                            <CheckBox Content="Data disk required" IsChecked="{Binding JobViewModel.NewDataDiskReqd}"/>
                            <CheckBox Content="Under warranty" IsChecked="{Binding JobViewModel.NewSystemUnderWarranty}"/>
                            <TextBox Text="{Binding JobViewModel.NewStaffBarcode}" Watermark="Your staff barcode"/>
                            <Button Content="Create Ticket" Command="{Binding JobViewModel.CreateJobCommand}" Background="ForestGreen" Foreground="White" HorizontalAlignment="Stretch"/>
                            <TextBlock Text="{Binding JobViewModel.StatusMessage}" FontStyle="Italic" TextWrapping="Wrap"/>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- Job list + selected job detail -->
                    <Grid Grid.Column="1" RowDefinitions="Auto,*">
                        <!-- Ticket search - any status, not just the open ones grouped below -->
                        <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="6" Margin="0,0,0,6">
                            <TextBox Width="260" Watermark="Search ticket #, customer, problem..." Text="{Binding JobViewModel.TicketSearchText}">
                                <TextBox.KeyBindings>
                                    <KeyBinding Gesture="Enter" Command="{Binding JobViewModel.SearchTicketsCommand}"/>
                                </TextBox.KeyBindings>
                            </TextBox>
                            <Button Content="Search" Command="{Binding JobViewModel.SearchTicketsCommand}"/>
                            <Button Content="Clear" Command="{Binding JobViewModel.ClearTicketSearchCommand}" IsVisible="{Binding JobViewModel.IsSearchActive}"/>
                        </StackPanel>

                        <!-- Search results - flat, spans every status -->
                        <Border Grid.Row="1" BorderBrush="Gray" BorderThickness="1" IsVisible="{Binding JobViewModel.IsSearchActive}">
                            <ListBox ItemsSource="{Binding JobViewModel.SearchResults}"
                                     SelectedItem="{Binding JobViewModel.SelectedJob}">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid ColumnDefinitions="50,*,30,150,30" Margin="5,3">
                                            <TextBlock Grid.Column="0" Text="{Binding JobId, StringFormat='#{0}'}" FontWeight="Bold"/>
                                            <TextBlock Grid.Column="1" Text="{Binding ProblemShort}"/>
                                            <TextBlock Grid.Column="2" Text="{Binding Priority}"/>
                                            <TextBlock Grid.Column="3" Text="{Binding JobStatus}" FontWeight="Bold"/>
                                            <TextBlock Grid.Column="4" Text="🔒" IsVisible="{Binding IsLocked}"/>
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Border>

                        <!-- Default view: open tickets grouped by status, with a count per
                             group - restores the legacy tree-style list (New/In Progress/QA/
                             etc. with a "+"/count) that this port had flattened away. -->
                        <Border Grid.Row="1" BorderBrush="Gray" BorderThickness="1" IsVisible="{Binding !JobViewModel.IsSearchActive}">
                            <ScrollViewer>
                                <ItemsControl ItemsSource="{Binding JobViewModel.GroupedOpenJobs}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Margin="0,0,0,2">
                                                <Button Command="{Binding ToggleExpandedCommand}" HorizontalAlignment="Stretch"
                                                        HorizontalContentAlignment="Left" Background="#E8E8E8" BorderThickness="0"
                                                        Padding="8,6" CornerRadius="0">
                                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                                        <TextBlock Text="{Binding ExpandGlyph}" FontSize="10" VerticalAlignment="Center"/>
                                                        <TextBlock Text="{Binding HeaderText}" FontWeight="Bold"/>
                                                    </StackPanel>
                                                </Button>
                                                <ListBox IsVisible="{Binding IsExpanded}" ItemsSource="{Binding Jobs}"
                                                         SelectedItem="{Binding $parent[Window].DataContext.JobViewModel.SelectedJob}">
                                                    <ListBox.ItemTemplate>
                                                        <DataTemplate>
                                                            <Grid ColumnDefinitions="50,*,30,150,30" Margin="5,3">
                                                                <TextBlock Grid.Column="0" Text="{Binding JobId, StringFormat='#{0}'}" FontWeight="Bold"/>
                                                                <TextBlock Grid.Column="1" Text="{Binding ProblemShort}"/>
                                                                <TextBlock Grid.Column="2" Text="{Binding Priority}"/>
                                                                <TextBlock Grid.Column="3" Text="{Binding CustomerName}"/>
                                                                <TextBlock Grid.Column="4" Text="🔒" IsVisible="{Binding IsLocked}"/>
                                                            </Grid>
                                                        </DataTemplate>
                                                    </ListBox.ItemTemplate>
                                                </ListBox>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Border>
                    </Grid>
                </Grid>

                <!-- Detail mode: full-width ticket detail, replacing the whole list-mode
                     layout above (including the New Ticket form) while a ticket is open. -->
                <Border Margin="0" Padding="10,10,4,10" Background="#F5F5F5" BorderBrush="Gray" BorderThickness="1"
                        IsVisible="{Binding JobViewModel.IsViewingTicket}">
                        <ScrollViewer>
                            <StackPanel Spacing="8" Margin="0,0,10,0">
                                <Grid ColumnDefinitions="*,Auto">
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="{Binding JobViewModel.SelectedJob.Summary}" FontWeight="Bold"/>
                                        <TextBlock Text="{Binding JobViewModel.SelectedJob.CustomerName}"/>
                                    </StackPanel>
                                    <Button Grid.Column="1" Content="✕ Back to list" VerticalAlignment="Top"
                                            Command="{Binding JobViewModel.CloseTicketCommand}"/>
                                </Grid>

                                <!-- Notes - problem details, diagnosis and service notes were being
                                     captured but never shown again once you left the job. -->
                                <Border Background="#FAFAF0" BorderBrush="#DDD" BorderThickness="1" Padding="8" Margin="0,4,0,0"
                                        IsVisible="{Binding JobViewModel.SelectedJob.ProblemLong, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                                    <StackPanel Spacing="2">
                                        <TextBlock Text="Problem Details" FontWeight="Bold" FontSize="11"/>
                                        <TextBlock Text="{Binding JobViewModel.SelectedJob.ProblemLong}" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </Border>
                                <Border Background="#FAFAF0" BorderBrush="#DDD" BorderThickness="1" Padding="8"
                                        IsVisible="{Binding JobViewModel.SelectedJob.Diagnosis, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                                    <StackPanel Spacing="2">
                                        <TextBlock Text="Diagnosis" FontWeight="Bold" FontSize="11"/>
                                        <TextBlock Text="{Binding JobViewModel.SelectedJob.Diagnosis}" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </Border>
                                <Border Background="#FAFAF0" BorderBrush="#DDD" BorderThickness="1" Padding="8"
                                        IsVisible="{Binding JobViewModel.SelectedJob.ServiceNotes, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                                    <StackPanel Spacing="2">
                                        <TextBlock Text="Service Notes" FontWeight="Bold" FontSize="11"/>
                                        <TextBlock Text="{Binding JobViewModel.SelectedJob.ServiceNotes}" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </Border>

                                <!-- Ticket notes log - a running log (unlike the single-value boxes
                                     above), color-coded so a private (internal-only) note is
                                     distinguishable from a public (customer-facing) one at a glance. -->
                                <TextBlock Text="Notes" FontWeight="Bold" Margin="0,6,0,0"/>
                                <ItemsControl ItemsSource="{Binding JobViewModel.Notes}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Classes.privateNote="{Binding IsPrivate}" Classes.publicNote="{Binding !IsPrivate}"
                                                    BorderThickness="1" Padding="8" Margin="0,0,0,4" CornerRadius="4">
                                                <StackPanel Spacing="2">
                                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                                        <TextBlock Text="🔒 Private" FontWeight="Bold" FontSize="10" IsVisible="{Binding IsPrivate}"/>
                                                        <TextBlock Text="🌐 Public" FontWeight="Bold" FontSize="10" IsVisible="{Binding !IsPrivate}"/>
                                                        <TextBlock Text="{Binding StaffName}" FontSize="10" Foreground="Gray"/>
                                                        <TextBlock Text="{Binding DateCreated, StringFormat='{}{0:dd-MMM-yyyy HH:mm}'}" FontSize="10" Foreground="Gray"/>
                                                    </StackPanel>
                                                    <TextBlock Text="{Binding NoteText}" TextWrapping="Wrap"/>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <StackPanel Spacing="6">
                                    <TextBox Watermark="Add a note... (can be a full paragraph)" Text="{Binding JobViewModel.NewNoteText}"
                                             AcceptsReturn="True" TextWrapping="Wrap" Height="80" MaxHeight="200"
                                             VerticalContentAlignment="Top"/>
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <CheckBox Content="Private" IsChecked="{Binding JobViewModel.NewNoteIsPrivate}"
                                                  ToolTip.Tip="Unchecked = written as if the customer might read it"/>
                                        <Button Content="Add Note" Command="{Binding JobViewModel.AddNoteCommand}"/>
                                    </StackPanel>
                                </StackPanel>

                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBox Width="150" Watermark="Staff barcode" Text="{Binding JobViewModel.ActionStaffBarcode}"/>
                                    <Button Content="Start Work" Command="{Binding JobViewModel.StartWorkCommand}" IsVisible="{Binding JobViewModel.CanStartWork}"/>
                                    <Button Content="Suspend" Command="{Binding JobViewModel.SuspendCommand}" IsVisible="{Binding JobViewModel.CanSuspend}"/>
                                    <Button Content="Send to QA" Command="{Binding JobViewModel.SendToQaCommand}" IsVisible="{Binding JobViewModel.CanSendToQa}"/>
                                    <Button Content="Back to Work" Command="{Binding JobViewModel.ReopenFromQaCommand}" IsVisible="{Binding JobViewModel.CanReopenFromQa}"/>
                                    <Button Content="Deliver" Command="{Binding JobViewModel.DeliverCommand}" IsVisible="{Binding JobViewModel.CanDeliver}" Background="ForestGreen" Foreground="White"/>
                                    <Button Content="Cancel Job" Command="{Binding JobViewModel.CancelJobCommand}" IsVisible="{Binding JobViewModel.CanCancel}" Background="Crimson" Foreground="White"/>
                                    <Button Content="Print Docket (PDF)" Command="{Binding JobViewModel.PrintDocketCommand}"/>
                                </StackPanel>

                                <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding JobViewModel.CanComplete}">
                                    <TextBox Width="300" Watermark="Service notes" Text="{Binding JobViewModel.ActionServiceNotes}"/>
                                    <Button Content="Complete" Command="{Binding JobViewModel.CompleteCommand}" Background="ForestGreen" Foreground="White"/>
                                </StackPanel>

                                <!-- Parts -->
                                <TextBlock Text="Parts" FontWeight="Bold" Margin="0,10,0,0"/>
                                <TextBox Text="{Binding JobViewModel.ScanPartBarcode}" Watermark="Scan part barcode" IsEnabled="{Binding JobViewModel.CanAddParts}">
                                    <TextBox.KeyBindings>
                                        <KeyBinding Gesture="Enter" Command="{Binding JobViewModel.AddPartCommand}"/>
                                    </TextBox.KeyBindings>
                                </TextBox>
                                <ListBox ItemsSource="{Binding JobViewModel.Parts}" Height="120">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Grid ColumnDefinitions="*,60,90,90,30" Margin="5,2">
                                                <TextBlock Grid.Column="0" Text="{Binding PartDescr}"/>
                                                <TextBlock Grid.Column="1" Text="{Binding Quantity, StringFormat=N0}" HorizontalAlignment="Right"/>
                                                <TextBlock Grid.Column="2" Text="{Binding SellPrice, StringFormat=C}" HorizontalAlignment="Right"/>
                                                <TextBlock Grid.Column="3" Text="{Binding CurrentSellPrice, StringFormat=C}" HorizontalAlignment="Right" Foreground="Crimson"
                                                           IsVisible="{Binding HasPriceDrift}"/>
                                                <Button Grid.Column="4" Content="x" Width="30"
                                                        Command="{Binding $parent[Window].DataContext.JobViewModel.RemovePartCommand}"
                                                        CommandParameter="{Binding}"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>

                                <!-- Notify Customer (SMS/Email) -->
                                <TextBlock Text="Notify Customer" FontWeight="Bold" Margin="0,10,0,0"/>
                                <TextBlock Text="{Binding JobViewModel.SelectedJob.CustomerMobile, StringFormat='Mobile: {0}'}" Foreground="Gray"/>
                                <TextBox Width="200" HorizontalAlignment="Left" Watermark="Email subject (optional)" Text="{Binding JobViewModel.NotifyEmailSubject}"/>
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBox Width="300" Watermark="Message" Text="{Binding JobViewModel.NotifyMessage}"/>
                                    <Button Content="Send SMS" Command="{Binding JobViewModel.SendSmsCommand}"/>
                                    <Button Content="Send Email" Command="{Binding JobViewModel.SendEmailCommand}"/>
                                </StackPanel>

                                <TextBlock Text="{Binding JobViewModel.StatusMessage}" FontStyle="Italic"/>
                            </StackPanel>
                        </ScrollViewer>
                        </Border>
                </Grid>
            </TabItem>

            <TabItem Header="Reference Data" Classes="navhidden">
                <TabControl SelectedIndex="{Binding SelectedReferenceSubTabIndex}">
                    <TabItem Header="Goods Types">
                        <views:ReferenceListEditorView DataContext="{Binding GoodsTypesViewModel}"/>
                    </TabItem>
                    <TabItem Header="Brands">
                        <views:ReferenceListEditorView DataContext="{Binding BrandsViewModel}"/>
                    </TabItem>
                    <TabItem Header="Symptoms">
                        <views:ReferenceListEditorView DataContext="{Binding SymptomsViewModel}"/>
                    </TabItem>
                    <TabItem Header="Task Types">
                        <views:ReferenceListEditorView DataContext="{Binding TaskTypesViewModel}"/>
                    </TabItem>
                </TabControl>
            </TabItem>
        </TabControl>
    </DockPanel>

</Window>
