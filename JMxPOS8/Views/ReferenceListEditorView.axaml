<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:JMxPOS8.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="700" d:DesignHeight="500"
             x:Class="JMxPOS8.Views.ReferenceListEditorView"
             x:DataType="vm:ReferenceDataViewModel">

    <Grid Margin="10" RowDefinitions="Auto,*,Auto,Auto">

        <TextBlock Grid.Row="0" Text="{Binding Title}" FontWeight="Bold" FontSize="16" Margin="0,0,0,10"/>

        <Border Grid.Row="1" BorderBrush="Gray" BorderThickness="1">
            <ListBox ItemsSource="{Binding Items}" SelectedItem="{Binding SelectedItem}" SelectionMode="Single">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid ColumnDefinitions="60,*" Margin="5,3">
                            <TextBlock Grid.Column="0" Text="{Binding Id}"/>
                            <TextBlock Grid.Column="1" Text="{Binding Description}"/>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Border>

        <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="8" Margin="0,10,0,0" IsVisible="{Binding !IsEditing}">
            <Button Content="New" Width="80" Command="{Binding NewCommand}"/>
            <Button Content="Edit" Width="80" Command="{Binding EditCommand}"/>
            <Button Content="Delete" Width="80" Command="{Binding DeleteCommand}" Background="Crimson" Foreground="White"/>
            <Button Content="Refresh" Width="80" Command="{Binding LoadAsyncCommand}"/>
        </StackPanel>

        <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="8" Margin="0,10,0,0" IsVisible="{Binding IsEditing}">
            <TextBox Width="300" Text="{Binding EditText}" MaxLength="{Binding MaxLength}" Watermark="Description"/>
            <Button Content="Save" Command="{Binding SaveAsyncCommand}" Background="ForestGreen" Foreground="White"/>
            <Button Content="Cancel" Command="{Binding CancelCommand}"/>
        </StackPanel>

        <TextBlock Grid.Row="3" Text="{Binding StatusMessage}" FontStyle="Italic" Margin="0,10,0,0"/>
    </Grid>
</UserControl>
